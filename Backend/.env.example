PORT=5000
NODE_ENV=development
CLUSTER_MODE=false
MONGO_URI=mongodb://127.0.0.1:27017/visvam_harvest
CORS_ORIGIN=http://localhost:8081,http://localhost:5173,http://localhost:3000,http://localhost:8080

# JWT Auth Secret — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do NOT reuse this file's committed value in any real environment.
JWT_SECRET=

# Cloudinary CDN Image Upload Config
CLOUDINARY_CLOUD_NAME=visvam-harvest
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Firebase Admin SDK Config
# Option 1: Path to Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option 2: Individual env vars (if service account JSON isn't available)
FIREBASE_PROJECT_ID=visvam-1be38
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shiprocket Logistics Configuration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=248001

# Resend Email Config (used for the newsletter subscription confirmation email)
RESEND_API_KEY=
EMAIL_FROM=Viśvam <hello@visvam.in>
